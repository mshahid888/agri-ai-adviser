# ==============================================================================
# Agri-AI Adviser — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ── LLM Configuration ────────────────────────────────────────────────────────
# For local development: http://localhost:20128/v1
# For Docker Desktop:    http://host.docker.internal:20128/v1
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_key_here
AGRI_AI_MODEL=gemini/gemini-3-flash-preview

# ── Embedding Configuration ──────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_BOOST_FACTOR=5.0

# ── Database ─────────────────────────────────────────────────────────────────
AGENT_DB_PATH=data/agent.db

# ── API Authentication ────────────────────────────────────────────────────────
# Set API_KEY to enable authentication on the HTTP API.
# When unset or empty, authentication is DISABLED (all requests accepted).
# Use a strong random string in production.
# Example: API_KEY=$(openssl rand -hex 32)
# API_KEY=

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for all origins.
CORS_ORIGINS=*

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ── Request Handling ──────────────────────────────────────────────────────────
REQUEST_TIMEOUT=120
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
UPLOAD_MAX_SIZE=10485760

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Environment ───────────────────────────────────────────────────────────────
# development | testing | production
ENVIRONMENT=development
